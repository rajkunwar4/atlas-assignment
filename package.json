{
  "name": "atlas-reconciliation",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api-node",
    "shared/conformance"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "install:all": "npm install && python3 -m pip install -r apps/api-python/requirements.txt",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:node": "dotenv -e .env -- npm --workspace apps/api-node run dev",
    "dev:python": "dotenv -e .env -- python3 -m uvicorn app.main:app --app-dir apps/api-python --reload --port 8000",
    "test:prepare": "dotenv -e .env -- python3 scripts/prepare_test_database.py",
    "test:node": "npm run test:prepare && dotenv -e .env -- npm --workspace apps/api-node test",
    "test:web": "npm --workspace apps/web test",
    "test:python": "npm run test:prepare && dotenv -e .env -- python3 -m pytest apps/api-python/tests",
    "test:conformance": "npm --workspace shared/conformance test",
    "test:e2e": "npm run reset:db && playwright test",
    "quality": "ruff check apps/api-python && prettier --check 'apps/**/*.{ts,tsx,json,css,html}' 'shared/**/*.{js,json}' 'e2e/**/*.ts' 'playwright.config.ts'",
    "test": "npm run test:python && npm run test:node && npm run test:web",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api-node run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "dotenv -e .env -- python3 -m alembic -c apps/api-python/alembic.ini upgrade head",
    "check:schema:node": "dotenv -e .env -- npm --workspace apps/api-node run check:schema",
    "reset:db": "dotenv -e .env -- python3 apps/api-python/scripts/reset_db.py",
    "reset:python": "npm run reset:db",
    "reset:node": "npm run reset:db",
    "seed:python": "dotenv -e .env -- python3 apps/api-python/scripts/seed.py",
    "seed:node": "dotenv -e .env -- npm --workspace apps/api-node run seed"
  }
}
